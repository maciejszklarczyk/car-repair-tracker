---
import { Button, buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
---

<div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
  <h1
    class="mb-6 bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-5xl leading-tight font-bold text-transparent sm:text-6xl lg:text-7xl"
  >
    Car Repair Tracker
  </h1>
  <p class="mb-10 max-w-2xl text-lg text-blue-100/70 sm:text-xl">
    Track repairs, know your cost/km, and never miss a service deadline — structured repair history without
    spreadsheets.
  </p>
  <div class="flex flex-col gap-4 sm:flex-row">
    <a
      href="/auth/signup"
      class:list={[
        cn(
          buttonVariants({
            variant: "default",
            size: "lg",
          }),
          "bg-purple-600 text-white hover:bg-purple-500",
        ),
      ]}
    >
      Sign Up
    </a>
    <a
      href="/auth/signin"
      class:list={[
        cn(
          buttonVariants({
            variant: "outline",
            size: "lg",
          }),
          "border-white/20 bg-transparent text-white hover:bg-white/10 hover:text-white",
        ),
      ]}
    >
      Sign In
    </a>
    <form method="POST" action="/api/demo">
      <Button
        variant="outline"
        size="lg"
        type="submit"
        className="border-emerald-400/40 bg-transparent text-emerald-200 hover:bg-emerald-500/10 hover:text-emerald-200"
      >
        Try Demo
      </Button>
    </form>
  </div>
</div>
