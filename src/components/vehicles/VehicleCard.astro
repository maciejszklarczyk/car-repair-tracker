---
import type { Vehicle } from "@/types";

interface Props {
  vehicle: Vehicle;
}

const { vehicle } = Astro.props;
---

<div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
  <h3 class="text-lg font-semibold text-white">
    {vehicle.make}
    {vehicle.model}
  </h3>
  <div class="mt-2 flex flex-wrap gap-4 text-sm text-blue-100/70">
    <span>Year: {vehicle.year}</span>
    <span>Mileage: {vehicle.current_mileage.toLocaleString()} km</span>
  </div>
  <div class="mt-4 flex gap-2">
    <a
      href={`/dashboard/vehicles/${vehicle.id}`}
      class="rounded-lg border border-white/20 px-3 py-1.5 text-xs font-medium text-blue-100/70 transition-colors hover:border-white/40 hover:text-white"
    >
      View details
    </a>
    <a
      href={`/dashboard/repairs/new?vehicle_id=${vehicle.id}`}
      class="rounded-lg bg-purple-600/70 px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-purple-500"
    >
      Add repair
    </a>
  </div>
</div>
