---
import Layout from "@/layouts/Layout.astro";
import EditRepairForm from "@/components/repairs/EditRepairForm";
import { createClient } from "@/lib/supabase";
import type { Repair, Vehicle } from "@/types";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/auth/signin");

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let repair: Repair | null = null;
if (id && supabase) {
  const result = await supabase.from("repairs").select("*").eq("id", id).single();
  if (result.data) {
    repair = result.data as Repair;
  }
}

if (repair?.user_id !== user.id) {
  return Astro.redirect("/dashboard/vehicles");
}

let vehicle: Vehicle | null = null;
if (supabase) {
  const result = await supabase
    .from("cars")
    .select("id, make, model, year, baseline_mileage")
    .eq("id", repair.car_id)
    .single();
  if (result.data) {
    vehicle = result.data as Vehicle;
  }
}

if (!vehicle) {
  return Astro.redirect("/dashboard/vehicles");
}

const vehicleName = `${vehicle.make} ${vehicle.model} (${vehicle.year})`;
---

<Layout title="Edit Repair">
  <div class="flex min-h-[calc(100vh-4rem)] items-center justify-center">
    <div class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Edit Repair
      </h1>
      <EditRepairForm
        client:load
        repair={repair}
        vehicleName={vehicleName}
        baselineMileage={vehicle.baseline_mileage}
      />
      <p class="mt-4 text-center text-sm text-blue-100/50">
        <a href={`/dashboard/vehicles/${vehicle.id}`} class="text-purple-300 hover:text-purple-200">
          Back to vehicle
        </a>
      </p>
    </div>
  </div>
</Layout>
