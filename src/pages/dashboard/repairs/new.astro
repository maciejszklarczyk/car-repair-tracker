---
import Layout from "@/layouts/Layout.astro";
import AddRepairForm from "@/components/repairs/AddRepairForm";
import { createClient } from "@/lib/supabase";

interface CarRow {
  id: string;
  make: string;
  model: string;
  year: number;
  user_id: string;
}

const user = Astro.locals.user;
if (!user) return Astro.redirect("/auth/signin");

const vehicleId = Astro.url.searchParams.get("vehicle_id");
const supabase = createClient(Astro.request.headers, Astro.cookies);

let car: CarRow | null = null;
if (vehicleId && supabase) {
  const { data } = await supabase.from("cars").select("id, make, model, year, user_id").eq("id", vehicleId).single();
  if (data) {
    car = data;
  }
}

if (car?.user_id !== user.id) {
  return Astro.redirect("/dashboard/vehicles");
}

const vehicleName = `${car.make} ${car.model} (${car.year})`;
const error = Astro.url.searchParams.get("error");
---

<Layout title="Add Repair">
  <div class="flex min-h-[calc(100vh-4rem)] items-center justify-center">
    <div class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Add Repair
      </h1>
      <AddRepairForm client:load carId={car.id} vehicleName={vehicleName} serverError={error} />
      <p class="mt-4 text-center text-sm text-blue-100/50">
        <a href={`/dashboard/vehicles/${car.id}`} class="text-purple-300 hover:text-purple-200">Back to vehicle</a>
      </p>
    </div>
  </div>
</Layout>
