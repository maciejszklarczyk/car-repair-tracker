---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { computeCostPerKm, computeCurrentMileage } from "@/lib/costPerKm";
import { computeThresholdSummary } from "@/lib/serviceReminders";
import RepairList from "@/components/repairs/RepairList";
import ServiceReminders from "@/components/service-reminders/ServiceReminders";
import ServiceThresholdList from "@/components/service-reminders/ServiceThresholdList";
import AddServiceThresholdForm from "@/components/service-reminders/AddServiceThresholdForm";
import type { Vehicle, Repair, ServiceThreshold } from "@/types";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/auth/signin");

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!id || !supabase) {
  return Astro.redirect("/dashboard/vehicles");
}

const result = await supabase
  .from("cars")
  .select("*")
  .eq("id", id)
  .eq("user_id", user.id)
  .is("archived_at", null)
  .single();
if (result.error || !result.data) {
  return Astro.redirect("/dashboard/vehicles");
}
const vehicle: Vehicle = result.data as Vehicle;

const { data: repairsData, error: repairsError } = await supabase
  .from("repairs")
  .select("*")
  .eq("car_id", id)
  .order("repair_date", { ascending: false });
if (repairsError) {
  return Astro.redirect("/dashboard/vehicles");
}
const repairs: Repair[] = repairsData as Repair[];

const { data: thresholdsData } = await supabase
  .from("service_thresholds")
  .select("*")
  .eq("car_id", id)
  .order("created_at", { ascending: true });
const thresholds: ServiceThreshold[] = (thresholdsData ?? []) as ServiceThreshold[];

const currentMileage = computeCurrentMileage(repairs, vehicle.baseline_mileage);
const costPerKm = computeCostPerKm(vehicle, repairs);
const thresholdSummary = computeThresholdSummary(thresholds, currentMileage);

const success = Astro.url.searchParams.get("success");
const successMessage =
  success === "1" ? "Repair added successfully." :
  success === "updated" ? "Repair saved." :
  success === "threshold_added" ? "Service threshold added." :
  success === "threshold_updated" ? "Service threshold updated." :
  null;
---

<Layout title={`${vehicle.make} ${vehicle.model}`}>
  <div class="mx-auto max-w-4xl">
    <div class="mb-6 flex items-center gap-4">
      <a href="/dashboard/vehicles" class="text-sm text-blue-100/50 transition-colors hover:text-blue-100/80">
        ← Back to vehicles
      </a>
    </div>

    {
      successMessage && (
        <div class="mb-6 rounded-lg border border-green-500/20 bg-green-500/10 p-4 text-sm text-green-200">
          {successMessage}
        </div>
      )
    }

    <div class="rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-xl">
      <div class="flex items-start justify-between">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            {vehicle.make}
            {vehicle.model}
          </h1>
          <div class="mt-3 flex flex-wrap gap-6 text-sm text-blue-100/70">
            <span>Year: {vehicle.year}</span>
            <span>Mileage: {currentMileage.toLocaleString()} km</span>
            <span>
              Cost/km:{" "}
              {
                costPerKm !== null ? (
                  `${costPerKm.toFixed(2)} PLN/km`
                ) : (
                  <span class="text-xs text-blue-100/40">(— PLN/km — no cost data yet)</span>
                )
              }
            </span>
          </div>
        </div>
        <a
          href={`/dashboard/repairs/new?vehicle_id=${vehicle.id}`}
          class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
        >
          Add repair
        </a>
      </div>
    </div>

    <ServiceReminders thresholds={thresholdSummary} client:load />

    <div class="mt-8">
      <h2 class="mb-4 text-xl font-semibold text-blue-100/80">Service Thresholds</h2>
      <ServiceThresholdList thresholds={thresholdSummary} client:load />
      <AddServiceThresholdForm carId={vehicle.id} client:load />
    </div>

    <div class="mt-8">
      <h2 class="mb-4 text-xl font-semibold text-blue-100/80">Repair History</h2>
      <RepairList repairs={repairs} client:load />
    </div>
  </div>
</Layout>
