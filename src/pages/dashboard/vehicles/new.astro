---
import Layout from "@/layouts/Layout.astro";
import AddVehicleForm from "@/components/vehicles/AddVehicleForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Add Vehicle">
  <div class="flex min-h-[calc(100vh-4rem)] items-center justify-center">
    <div class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Add Vehicle
      </h1>
      <AddVehicleForm client:load serverError={error} />
      <p class="mt-4 text-center text-sm text-blue-100/50">
        <a href="/dashboard/vehicles" class="text-purple-300 hover:text-purple-200">Back to vehicles</a>
      </p>
    </div>
  </div>
</Layout>
